<% content_for :title, "受付ガイド | AI受付ロボット" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% preview_mode = ReceptionMode.preview? %>
<div class="page-shell" data-controller="chat" data-chat-max-characters-value="<%= RobotRun::MAX_INPUT_CHARACTERS %>" data-chat-available-value="<%= @screen[:available] %>" data-chat-state-message-value="<%= @screen[:message] %>" data-chat-history-version-value="<%= @screen[:history_version] %>" data-chat-state-url-value="<%= chat_state_path %>" data-chat-history-url-value="<%= chat_history_path %>" data-chat-send-label-value="<%= preview_mode ? '仮応答を確認 ↑' : '送信する ↑' %>">
  <header class="site-header">
    <a href="<%= root_path %>" class="brand" aria-label="受付ガイド ホーム">
      <span class="brand-mark"><%= render "shared/robot_icon" %></span>
      <span><strong>受付ガイド</strong><small>AI RECEPTION ROBOT</small></span>
    </a>
    <span class="mode-badge"><span></span><%= preview_mode ? "仮応答モード" : "AI受付モード" %></span>
  </header>
  <div class="intro">
    <div><p class="eyebrow">WELCOME TO THE EVENT</p><h1>どちらへご案内しますか？</h1></div>
    <p>ご用件をメッセージでお聞かせください。</p>
  </div>

  <main class="workspace">
    <section class="chat-panel" aria-labelledby="conversation-heading">
      <div class="panel-header">
        <div><span class="section-dot"></span><h2 id="conversation-heading">受付ガイドとの会話</h2></div>
        <span class="input-status" role="status" data-chat-target="status"><%= @screen[:message] %></span>
      </div>
      <div class="messages" role="log" aria-label="会話の履歴" data-chat-target="messages">
        <div class="welcome-message">
          <span class="assistant-avatar"><%= render "shared/robot_icon" %></span>
          <div><p class="sender-name">受付ガイド</p><div class="bubble assistant-bubble">こんにちは。受付や講演会場へのご案内をお手伝いします。<br><%= preview_mode ? "下の入力例から、仮応答の表示をお試しいただけます。" : "ご用件を入力してください。アームの身振りでご案内します。" %></div></div>
        </div>
        <%= turbo_frame_tag "chat_history", data: { chat_target: "history", action: "turbo:frame-load->chat#historyLoaded" } do %><%= render "runs" %><% end %>
        <p class="history-note">このブラウザの最近<%= RobotRun::HISTORY_LIMIT %>件までの履歴を表示します。</p>
      </div>
      <div class="composer">
        <div class="form-errors" role="alert" data-chat-target="errors" <%= "hidden" unless @robot_run.errors.any? %>>
            <% @robot_run.errors.map(&:message).uniq.each do |message| %><p><%= message %></p><% end %>
        </div>
        <%= form_with model: @robot_run, url: chat_path, id: "chat-form", data: { turbo: false, action: "submit->chat#send" } do |form| %>
          <div class="composer-labels">
            <%= form.label :input_text, "メッセージ", class: "field-label" %>
            <% if preview_mode %><div class="scenario-field"><%= form.label :preview_scenario, "確認する仮応答" %><%= form.select :preview_scenario, PreviewResponse::SCENARIOS.map { |key, value| [ value.fetch(:label), key ] }, {}, data: { chat_target: "scenario" } %></div><% end %>
          </div>
          <%= form.text_area :input_text, rows: 3, required: true, placeholder: "例：参加受付はどこですか？", aria: { describedby: "message-help message-counter", invalid: @robot_run.errors[:input_text].any? }, data: { chat_target: "input", action: "input->chat#update keydown->chat#keydown" } %>
          <div class="composer-footer">
            <span id="message-help">Enterで送信 / Shift+Enterで改行</span>
            <div><span id="message-counter" data-chat-target="counter">0 / <%= RobotRun::MAX_INPUT_CHARACTERS %></span><%= form.button type: "submit", class: "send-button", data: { chat_target: "submit" } do %><%= preview_mode ? "仮応答を確認" : "送信する" %><span aria-hidden="true">↑</span><% end %></div>
          </div>
        <% end %>
      </div>
    </section>

    <aside class="guide-panel" aria-label="案内先と入力例">
      <section class="preview-notice"><span class="notice-icon" aria-hidden="true">i</span><h2><%= preview_mode ? "画面プレビュー" : "アームによるご案内" %></h2><p><%= preview_mode ? "仮応答の表示を確認する画面です。AIによる判定やロボットの動作は行いません。" : "ご用件をAIが判定し、シミュレータのアームが身振りでご案内します。一度に1件ずつ対応します。" %></p></section>
      <section class="destinations"><p class="eyebrow">DESTINATIONS</p><h2>ご案内できる場所</h2><div class="destination reception-destination"><div><strong>受付</strong><p>参加登録・お申し込みの確認</p></div><span aria-label="右方向">→</span></div><div class="destination hall-destination"><div><strong>講演会場</strong><p>講演・発表を聞く会場</p></div><span aria-label="左方向">←</span></div></section>
      <section class="examples"><h2>入力例を使う</h2>
        <% [["こんにちは", "こんにちは。", "greeting"], ["受付を探す", "参加受付はどこですか？", "reception"], ["講演会場を探す", "講演会場はどちらですか？", "hall"], ["案内先がわからない", "どこに行けばいいですか？", "unknown"]].each do |label, text, scenario| %>
          <button type="button" data-action="chat#example" data-chat-text-param="<%= text %>" data-chat-scenario-param="<%= scenario %>"><%= label %><span aria-hidden="true">↗</span></button>
        <% end %>
      </section>
      <p class="privacy-note"><span aria-hidden="true">◈</span> 履歴はこのブラウザだけに表示されます。</p>
    </aside>
  </main>
  <footer class="site-footer">AI受付ロボット <span>メッセージごとにご用件を確認します。</span></footer>
</div>
